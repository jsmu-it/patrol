# .env produksi untuk absen.jsmu.co.id
# Salin ke backend/api/.env di server, lalu isi yang bertanda GANTI.
# Jangan pernah commit file .env asli ke git.

APP_NAME=JSMUGuard
APP_ENV=production
APP_KEY=                      # GANTI: hasil `php artisan key:generate`
APP_DEBUG=false               # WAJIB false di produksi
APP_URL=https://absen.jsmu.co.id

LOG_CHANNEL=stack
LOG_LEVEL=error

# Database (host "db" = nama service di docker-compose)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=jsmuguard_db
DB_USERNAME=jsmu_user
DB_PASSWORD=                  # GANTI: password kuat, samakan dengan .env root repo
DB_ROOT_PASSWORD=             # GANTI: password root MySQL (dipakai container db)

# Redis dipakai untuk cache, session, dan queue
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Cookie hanya dikirim lewat HTTPS
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=absen.jsmu.co.id
SANCTUM_STATEFUL_DOMAINS=absen.jsmu.co.id

FILESYSTEM_DISK=public

MAIL_MAILER=smtp
MAIL_HOST=srv181.niagahoster.com
MAIL_PORT=465
MAIL_USERNAME=                # GANTI kalau mau kirim email
MAIL_PASSWORD=                # GANTI
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="no-reply@jsmu.co.id"
MAIL_FROM_NAME="${APP_NAME}"

# Firebase / FCM untuk push notification mobile (kalau dipakai)
# FIREBASE_CREDENTIALS=/var/www/storage/app/firebase.json
